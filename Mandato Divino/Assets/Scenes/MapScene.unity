  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Recolecta - El aldeano se va a recoger recursos despues de que cliques
    en la fuente de un recurso\n\nRepara - El aldeano reconstruy un edificio destruido
    despues de que cliques sobre este y si tienes los recursos\n\nDestruye - Borras
    po completo el edificio que cliques\n\nCocina - El aldeano se pone a hacerse
    la comida si lleva algo de comida y usa una sarten\n\nCome - El aldeano recupera
    fuerzas comiendo un poco\n\nPara - El aldeano deja de hacer lo que estuviera
    haciendo\n\nDescansa - El aldeano se va a reponer fuerzas a su casa si tiene
    una\n\nHijos - El aldeano y su pareja crean un ni\xF1o si tienen una casa para
    ello\n\nLucha - El aldeano peleara contra un enemigo que cliques\n\nInfo: Datos
    del aldeano seleccionado\nLista: Datos de todos los aldeanos\nInventario: Objetos
    que posee el aldeano\nPausa: Detiene la partida\nCerrar: Te devuelve al juego\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a95a087a1a52f0f4b91cd48e427ba4b5, type: 2}
